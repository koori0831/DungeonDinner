.dispatch-screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(61, 40, 28);
    font-size: 17px;
}

.is-hidden { display: none; }

.screen-dim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(48, 35, 28);
}

.ledger {
    width: 92%; max-width: 1600px;
    height: 92%; min-height: 0;
    padding: 30px;
    background-color: transparent;
    border-width: 0;
}

/* Paper is a decorative first child, inside the shared brown frame. */
.ledger-paper, .panel-paper {
    position: absolute;
    left: 12px; right: 12px; top: 12px; bottom: 12px;
    background-color: transparent;
}
.ledger-paper { left: 20px; right: 20px; top: 20px; bottom: 20px; }

.ledger-header {
    height: 88px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(180, 158, 128);
}

.title, .modal-title {
    min-height: 48px;
    padding: 8px 28px;
    background-color: transparent;
    color: rgb(248, 239, 215);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.title { font-size: 29px; }

.subtitle, .section-hint, .row-subtitle, .return-label, .remaining-label {
    color: rgb(103, 76, 54);
    font-size: 15px;
}
.section-hint, .subtitle, .return-label { white-space: normal; }
.subtitle { margin-top: 5px; }

.time-block {
    min-width: 150px;
    flex-shrink: 0;
    align-items: center;
    padding: 8px 18px;
    background-color: transparent;
    border-width: 0;
}
.time-day { font-size: 20px; -unity-font-style: bold; }
.time-value { margin-top: 4px; font-size: 16px; color: rgb(132, 68, 35); }

.tab-bar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    padding: 0 12px 6px;
}

.dispatch-button-skin, .primary-button, .secondary-button,
.tab-button, .quantity-button, .close-button {
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    color: rgb(61, 40, 28);
    -unity-font-style: bold;
    -unity-background-image-tint-color: white;
    -unity-text-align: middle-center;
}
.dispatch-button-skin.is-secondary, .secondary-button, .close-button {
    color: rgb(248, 239, 215);
}
.dispatch-button-skin:hover { -unity-background-image-tint-color: rgb(255, 237, 198); }
.dispatch-button-skin:active { -unity-background-image-tint-color: rgb(220, 188, 139); }
.dispatch-button-skin:focus { border-width: 2px; border-color: rgb(173, 106, 44); }
.dispatch-button-skin:disabled {
    opacity: 1;
    color: rgb(78, 60, 43);
    -unity-background-image-tint-color: rgb(200, 189, 168);
    border-width: 0;
}
.dispatch-button-skin.is-secondary:disabled { color: rgb(231, 222, 202); }

.close-button {
    width: 52px; height: 52px;
    flex-shrink: 0;
    padding: 0;
    font-size: 30px;
}
.tab-button {
    width: 164px; height: 44px;
    margin-right: 8px;
    padding: 6px 18px;
    font-size: 18px;
}
.tab-button.is-selected { height: 48px; color: rgb(61, 40, 28); }

.page {
    flex-grow: 1;
    min-height: 0;
    background-color: transparent;
    border-width: 0;
}
.request-page { flex-direction: row; }
.ledger-column { min-width: 0; min-height: 0; padding: 16px; }
.roster-column {
    width: 28%;
    border-right-width: 1px;
    border-right-color: rgb(188, 165, 135);
}
.request-column {
    width: 42%;
    border-right-width: 1px;
    border-right-color: rgb(188, 165, 135);
}
.summary-column { width: 30%; }
.section-title {
    margin-bottom: 5px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(75, 48, 33);
}
.centered { -unity-text-align: middle-center; }

.ledger-list {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    padding: 4px;
    background-color: rgb(243, 232, 209);
    border-width: 1px;
    border-color: rgb(166, 138, 104);
    border-radius: 4px;
}
.ledger-list .unity-collection-view__item,
.ledger-list .unity-collection-view__item:checked,
.ledger-list .unity-collection-view__item:hover { background-color: transparent; }
.region-list { height: 112px; flex-grow: 0; flex-shrink: 0; }
.material-title { margin-top: 16px; }
.material-list { flex-grow: 1; }

.list-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin: 3px 4px;
    padding: 6px 8px;
    background-color: transparent;
    border-width: 2px;
    border-color: transparent;
    border-radius: 3px;
    -unity-background-image-tint-color: white;
}
.list-row:hover {
    border-color: rgb(168, 126, 71);
    -unity-background-image-tint-color: rgb(250, 235, 204);
}
.list-row.is-selected {
    border-color: rgb(139, 78, 36);
    -unity-background-image-tint-color: rgb(245, 212, 155);
}
.list-row.is-locked { opacity: 1; -unity-background-image-tint-color: rgb(227, 219, 202); }

.portrait-placeholder, .material-icon-frame {
    width: 46px; height: 46px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    background-color: rgb(92, 66, 49);
    border-radius: 23px;
}
.portrait-initial { font-size: 22px; color: rgb(248, 239, 215); -unity-font-style: bold; }
.row-text-group, .report-main { flex-grow: 1; min-width: 0; }
.row-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(61, 40, 28);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.row-subtitle { margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.state-badge {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 4px 7px;
    background-color: rgb(225, 230, 198);
    color: rgb(65, 80, 44);
    border-width: 1px;
    border-color: rgb(142, 152, 110);
    border-radius: 4px;
    font-size: 14px;
}
.list-row.is-locked .state-badge {
    background-color: rgb(228, 214, 192);
    color: rgb(107, 69, 42);
    border-color: rgb(163, 131, 93);
}
.material-icon-frame { background-color: rgb(225, 208, 180); border-radius: 4px; }
.material-icon { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; }
.quantity-control { flex-shrink: 0; flex-direction: row; align-items: center; margin-left: 6px; }
.quantity-button { width: 44px; height: 44px; flex-shrink: 0; padding: 0; font-size: 22px; }
.quantity-label { width: 38px; -unity-text-align: middle-center; font-size: 18px; -unity-font-style: bold; }

.summary-slip, .status-card, .report-panel, .modal-card {
    background-color: transparent;
    border-width: 0;
}
.summary-slip {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    padding: 24px;
}
.summary-scroll { flex-grow: 1; min-height: 0; }
.summary-scroll .unity-scroll-view__content-container { padding-right: 5px; }
.summary-key { margin-top: 9px; margin-bottom: 3px; color: rgb(111, 78, 49); font-size: 14px; }
.summary-value { font-size: 18px; -unity-font-style: bold; white-space: normal; }
.summary-materials { min-height: 66px; }
.divider { height: 1px; flex-shrink: 0; margin: 12px 0; background-color: rgb(180, 148, 106); }
.duration-label { font-size: 22px; -unity-font-style: bold; color: rgb(133, 65, 31); white-space: normal; }
.rare-hint { margin-top: 10px; color: rgb(106, 71, 100); font-size: 15px; white-space: normal; }
.message-label {
    min-height: 38px;
    flex-shrink: 0;
    margin-bottom: 6px;
    color: rgb(136, 60, 40);
    font-size: 16px;
    white-space: normal;
}
.primary-button, .secondary-button {
    min-height: 46px;
    flex-shrink: 0;
    padding: 10px 18px;
    font-size: 18px;
}

.single-page { align-items: center; justify-content: center; padding: 20px; }
.status-card, .report-panel { width: 78%; height: 94%; min-height: 0; padding: 30px; }
.active-title { margin-top: 28px; font-size: 28px; -unity-text-align: middle-center; -unity-font-style: bold; white-space: normal; }
.active-region, .active-requests, .remaining-label { margin-top: 12px; -unity-text-align: middle-center; white-space: normal; }
.dispatch-progress { height: 30px; flex-shrink: 0; margin-top: 28px; }
.dispatch-progress .unity-progress-bar__background {
    background-color: rgb(230, 216, 190);
    border-width: 1px;
    border-color: rgb(140, 106, 73);
    border-radius: 3px;
}
.dispatch-progress .unity-progress-bar__progress { background-color: rgb(196, 151, 86); border-width: 0; border-radius: 2px; }
.dispatch-progress .unity-progress-bar__title { color: rgb(61, 40, 28); -unity-font-style: bold; }
.report-panel { width: 86%; }
.report-list { margin-top: 16px; }
.report-row { min-height: 108px; }
.report-rewards { margin-top: 7px; white-space: normal; color: rgb(76, 49, 29); }
.claim-button { width: 128px; margin-left: 12px; }
.empty-label { flex-grow: 1; -unity-text-align: middle-center; font-size: 20px; color: rgb(111, 80, 54); white-space: normal; }

.modal-layer {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(31, 23, 18, 0.86);
}
.modal-card { width: 520px; max-width: 86%; max-height: 86%; padding: 32px; }
.modal-title { flex-shrink: 0; font-size: 25px; }
.modal-scroll { min-height: 0; max-height: 360px; flex-shrink: 1; margin: 16px 0; }
.modal-text { min-height: 100px; padding: 8px; font-size: 18px; white-space: normal; -unity-text-align: middle-center; }
.modal-buttons { flex-shrink: 0; flex-direction: row; justify-content: space-between; }
.modal-buttons > .unity-button { width: 47%; }

.dispatch-screen .unity-scroller--vertical {
    width: 16px; min-width: 16px;
    background-color: rgb(231, 217, 193);
    border-radius: 4px;
}
.dispatch-screen .unity-scroller--vertical .unity-base-slider__tracker#unity-tracker {
    background-color: rgb(215, 196, 166);
    background-image: none;
    border-width: 0;
}
.dispatch-screen .unity-scroller--vertical .unity-base-slider__dragger#unity-dragger {
    min-height: 28px;
    background-color: rgb(125, 91, 61);
    background-image: none;
    border-width: 0;
    border-radius: 4px;
}
.dispatch-screen .unity-scroller--vertical .unity-base-slider__dragger#unity-dragger:hover {
    background-color: rgb(155, 109, 61);
}
.dispatch-screen .unity-scroller--vertical .unity-base-slider__dragger-border#unity-dragger-border {
    background-color: transparent;
    background-image: none;
    border-width: 0;
}
.dispatch-screen .unity-scroller__low-button, .dispatch-screen .unity-scroller__high-button { display: none; }

.toast {
    position: absolute;
    left: 25%; right: 25%; bottom: 26px;
    min-height: 44px;
    padding: 12px 18px;
    background-color: rgb(78, 56, 44);
    color: rgb(248, 239, 215);
    -unity-text-align: middle-center;
    white-space: normal;
    border-width: 1px;
    border-color: rgb(188, 148, 91);
    border-radius: 5px;
}
