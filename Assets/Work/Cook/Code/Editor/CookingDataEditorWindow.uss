.cooking-editor-root {
    background-color: #202124;
    color: #e6e1d8;
}

.top-bar {
    min-height: 72px;
    flex-shrink: 0;
    padding: 12px 16px 10px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #2b2d31;
    border-bottom-width: 1px;
    border-bottom-color: #41444a;
}

.title-block {
    flex-grow: 1;
}

.window-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #f0e8dc;
}

.window-guide {
    margin-top: 4px;
    color: #b9b2a8;
}

.catalog-field {
    min-width: 300px;
    margin-left: 16px;
}

.fixed-layout {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    overflow: hidden;
}

.left-panel {
    width: 360px;
    min-width: 360px;
    max-width: 360px;
    flex-shrink: 0;
    padding: 14px;
    background-color: #26282d;
    border-right-width: 1px;
    border-right-color: #41444a;
}

.right-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 16px;
    background-color: #202124;
}

.panel-heading {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f0e8dc;
}

.mode-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    margin-bottom: 8px;
}

.mode-tab {
    width: 82px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
}

.mode-tab-selected {
    background-color: #3a526b;
    color: #eaf4ff;
    -unity-font-style: bold;
    border-color: #6e91b5;
}

.summary-label {
    margin-top: 6px;
    margin-bottom: 10px;
    padding: 10px;
    color: #d8d2ca;
    background-color: #303238;
    border-width: 1px;
    border-color: #444850;
    border-radius: 8px;
}

.search-field {
    margin-bottom: 8px;
}

.folder-field {
    margin-bottom: 8px;
}

.action-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.action-row Button {
    flex-grow: 1;
    margin-right: 6px;
    border-radius: 8px;
}

.count-label {
    margin-top: 2px;
    margin-bottom: 8px;
    color: #b2aca5;
}

.recipe-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 180px;
    background-color: #24262b;
    border-width: 1px;
    border-color: #444850;
    border-radius: 8px;
}

.recipe-list-item {
    height: 60px;
    padding: 8px 10px;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: #353840;
}

.recipe-list-name {
    -unity-font-style: bold;
    color: #f1e8dc;
}

.recipe-list-meta {
    margin-top: 3px;
    font-size: 11px;
    color: #aaa39b;
}

.detail-header {
    min-height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.detail-title-block {
    flex-grow: 1;
}

.detail-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #f0e8dc;
}

.detail-meta {
    margin-top: 4px;
    color: #aaa39b;
}

.save-state {
    padding: 6px 10px;
    color: #f4dcaa;
    background-color: #3b3529;
    border-width: 1px;
    border-color: #6c5b38;
    border-radius: 8px;
}

.help-box {
    padding: 10px;
    margin-bottom: 10px;
    background-color: #27313a;
    border-width: 1px;
    border-color: #40586b;
    border-radius: 8px;
    color: #d8e4ec;
}

.detail-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.recipe-form {
    flex-shrink: 0;
    padding: 12px;
    background-color: #292b30;
    border-width: 1px;
    border-color: #444850;
    border-radius: 8px;
}

.footer-actions {
    min-height: 42px;
    flex-shrink: 0;
    margin-top: 10px;
    flex-direction: row;
    justify-content: flex-end;
}

.footer-actions Button {
    min-width: 112px;
    margin-left: 8px;
    border-radius: 8px;
}
